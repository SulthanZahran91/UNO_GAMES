{
  "name": "uno-game",
  "version": "1.0.0",
  "description": "Real-time multiplayer UNO game with Firebase",
  "private": true,
  "workspaces": [
    "client",
    "functions"
  ],
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:functions": "cd functions && npm run serve",
    "build": "npm run build:client",
    "build:client": "cd client && npm run build",
    "test": "npm run test --workspaces",
    "test:client": "cd client && npm test",
    "test:functions": "cd functions && npm test",
    "typecheck": "echo 'ℹ️  This is a JavaScript project (no TypeScript compilation needed)'",
    "deploy": "npm run build && firebase deploy"
  },
  "devDependencies": {
    "firebase-tools": "^14.24.2"
  }
}
